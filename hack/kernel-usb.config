# izba USB-passthrough kernel variant (dist/vmlinux-usb).
#
# Merged ON TOP of hack/kernel.config, which disables USB entirely — a sandbox
# without device grants must boot a kernel that physically cannot talk to a USB
# device (design D4). This file exists to re-enable it for the sandboxes that
# have been granted one, and for nothing else: the two images are separate
# artifacts, and izbad picks between them from the sandbox's grants.
#
# Build:
#   IZBA_KERNEL_EXTRA_CONFIG=hack/kernel-usb.config \
#     hack/build-kernel.sh 6.12.30 dist/vmlinux-usb
#
# There is no module loader in the initramfs (izba-init never calls modprobe),
# so every symbol here is =y, never =m. The build script asserts that each one
# survived `make olddefconfig`, which is what catches a symbol silently dropped
# for an unmet dependency — the failure mode where a "USB kernel" ships without
# the very driver it exists for.

# The USB core. USB_SUPPORT is the menu gate the base fragment turns off;
# USB is the host-side stack vhci registers with.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_COMMON=y

# usbip: the virtual host controller. vhci-hcd takes a socket fd and presents
# whatever is on the other end as a locally attached device — the entire reason
# izba can pass a device over vsock without emulating a USB controller (neither
# Cloud Hypervisor nor OpenVMM has one).
CONFIG_USBIP_CORE=y
CONFIG_USBIP_VHCI_HCD=y

# Serial-class drivers only (design D5). This is the guest half of the same
# restriction the container's cgroup device filter enforces: a device outside
# these classes enumerates into nothing the workload can open.
#
# CDC-ACM covers most dev boards presenting a standard USB serial interface
# (including the ESP32-S3/C3 native USB CDC that motivated the feature).
CONFIG_USB_ACM=y
# The generic USB-serial layer plus the four bridge chips that account for
# essentially every USB-to-UART adapter in the wild: Silicon Labs CP210x,
# WCH CH341, FTDI, and Prolific PL2303.
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y

# No PHYSICAL USB host controllers. The microVM has no USB hardware — neither
# Cloud Hypervisor nor OpenVMM emulates a USB controller at all — so xHCI/EHCI/
# OHCI/UHCI drivers here would be code that can never bind to anything. The base
# defconfig enables them; turn them back off, so "USB kernel" means exactly one
# controller: the virtual one izba drives over vsock.
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_UHCI_HCD is not set
